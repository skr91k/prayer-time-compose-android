<?xml version="1.0" encoding="utf-8"?>
<!-- Each spelling is a shortcut so launcher search finds the app; order = long-press menu order.
     Debug copy: src/debug/res/xml/shortcuts.xml (same list, .debug package). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="alias_qibla"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher_gold"
        android:shortcutShortLabel="@string/alias_qibla">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetClass="shakir.swalah.ui.MainActivity"
            android:targetPackage="shakir.swalah">
            <extra android:name="route" android:value="qibla" />
        </intent>
    </shortcut>
